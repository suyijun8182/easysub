# ===== 基础 =====
# 数据库连接不在此配置：首次访问网页会进入「数据库安装向导」，
# 在网页上填写 MySQL 主机/端口/用户/密码/库名并测试连接后保存。

# 可选强 JWT 密钥（openssl rand -hex 32）；留空自动保存到 data/jwt_secret，必须保留数据卷
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# 时区（定时提醒按此时区运行）
TZ=Asia/Shanghai

# ===== Telegram =====
# 通过 @BotFather 获取
TELEGRAM_BOT_TOKEN=

# ===== 汇率 API =====
# 默认使用 open.er-api.com（免费免 key）。如用需要 key 的服务在此填入
EXCHANGE_API_BASE=USD
EXCHANGE_API_URL=https://open.er-api.com/v6/latest/
EXCHANGE_API_KEY=

# 每日提醒扫描时间（24h，HH:MM）
REMINDER_SCAN_TIME=09:00

# 可选初始管理员；不设置密码时，第一个注册的账号就是管理员
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-strong-password
ADMIN_EMAIL=admin@example.com
